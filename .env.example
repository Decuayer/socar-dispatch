DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=socar_dispatch;Username=postgres;Password=postgrespassword

# Database (PostgreSQL + PostGIS)
POSTGRES_DB=socar_dispatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO / Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_secret_key_here
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT Settings
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_ISSUER=SocarDispatchAPI
JWT_AUDIENCE=SocarDispatchUsers