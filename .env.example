
# Database (PostgreSQL + PostGIS)
POSTGRES_DB=socar_dispatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=socar_dispatch;Username=postgres;Password=postgrespassword

# Caching Layer (Redis)
REDIS_PORT=6379
REDIS_CONNECTION_STRING=localhost:6379

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=socar-dispatch-media
MINIO_ENDPOINT=http://localhost:9000

# JWT Settings
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_ISSUER=SocarDispatchAPI
JWT_AUDIENCE=SocarDispatchUsers